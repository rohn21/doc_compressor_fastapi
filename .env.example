# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="Document Compressor"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=document_compressor
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Optional Direct Database URL overrides
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/document_compressor
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/document_compressor

# Redis / Task Queue
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=50
MAX_BATCH_FILES=20
